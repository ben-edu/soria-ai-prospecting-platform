APP_NAME="SORIA AI Prospecting Platform"
APP_ENV="local"
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://soria:soria@localhost:5432/soria_prospecting"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
SECRET_KEY="change-me"
